# Environment Configuration

# Server
PORT=3000
NODE_ENV=production
API_SECRET_KEY=your-secret-key-change-this
CRM_DASHBOARD_PASSWORD=replace-with-a-long-unique-password

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=storesg_crm
DB_USER=postgres
DB_PASSWORD=your-db-password

# Redis
REDIS_URL=redis://localhost:6379

# WhatsApp Business API (Meta)
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-verify-token
WHATSAPP_APP_SECRET=your-app-secret
WHATSAPP_API_VERSION=v25.0
WHATSAPP_REQUEST_TIMEOUT_MS=15000

# Shopify
SHOPIFY_STORE_URL=https://storesgmedellin.co
SHOPIFY_ACCESS_TOKEN=your-shopify-access-token
SHOPIFY_WEBHOOK_SECRET=your-webhook-secret
SHOPIFY_API_VERSION=2024-01

# AI (mimo V2.5 PRO)
AI_API_URL=https://api.mimo.com/v1
AI_API_KEY=your-api-key
AI_MODEL=mimo-v2.5-pro
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=500

# Business Info
BUSINESS_NAME=STORE SG MEDELLÍN
BUSINESS_PHONE=+573233817923
BUSINESS_EMAIL=storegmedellin@gmail.com
BUSINESS_ADDRESS=Carrera 49A #94-58, Medellín, Colombia
BUSINESS_HOURS=11:00-21:00
BUSINESS_TIMEZONE=America/Bogota

# Text-to-speech (edge or elevenlabs)
TTS_PROVIDER=edge
TTS_VOICE=es-CO-SalomeNeural
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-elevenlabs-voice-id
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
